# --- Auth ---
JWT_SECRET_KEY=

# --- Database ---
MONGO_URI=

# --- Redis (rate limiting and abuse blocking) ---
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USER=
RABBITMQ_PASS=

# --- Verification email ---
sender_email=
sender_password=

# --- Cloudinary (profile image) ---
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# --- Mercado Pago ---
MERCADOPAGO_SECRET_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Google Cloud (Vertex AI) ---
# Service account path. The file is generated at runtime from the GOOGLE_*
# variables below; this is the only variable that points to it.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Service account: contents written to GOOGLE_APPLICATION_CREDENTIALS ---
GOOGLE_TYPE=
GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=
GOOGLE_CLIENT_X509_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=
